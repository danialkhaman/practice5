# Скопируйте в .env (cp .env.example .env) и при необходимости поменяйте значения.
# Здесь НЕТ и не должно быть секретов: закрытых ключей, seed-фраз, паролей.
# Все скрипты работают с разблокированными тестовыми аккаунтами локального Anvil.

# --- dApp (Vite читает только переменные с префиксом VITE_) ---
VITE_RPC_URL=http://127.0.0.1:8545
VITE_TELEMETRY_URL=http://localhost:8787/telemetry

# --- деплой, сценарии, монитор ---
RPC_URL=http://127.0.0.1:8545
# CONTRACT_ADDRESS=0x...        # по умолчанию берётся из web/public/deployment.json
COLLECTOR_PORT=8787
POLL_MS=1000
RPC_TIMEOUT_MS=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALERT_WEBHOOK_URL=            # необязательно: вебхук для тревог; реальный URL — только в .env

# --- нагрузочный эксперимент ---
LOAD_TOTAL=30
LOAD_CLIENTS=5
LOAD_PORT=8565
LOAD_MODES=blocktime1,automine
